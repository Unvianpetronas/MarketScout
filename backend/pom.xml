<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.4</version>
		<relativePath/>
	</parent>

	<groupId>com.marketscout</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>MarketScout Backend</name>
	<description>Trade partner verification SaaS — Team ARAM #278</description>

	<properties>
		<java.version>21</java.version>

		<!-- Versions không được quản lý bởi Spring Boot BOM -->
		<jjwt.version>0.12.6</jjwt.version>
		<springdoc.version>3.0.1</springdoc.version>
		<modelmapper.version>3.2.1</modelmapper.version>
		<google-api-client.version>2.7.0</google-api-client.version>
	</properties>

	<dependencies>

		<!-- ══════════════════════════════════════════════════
             NHÓM 1: WEB & API
             Cần cho: REST endpoints, validation input
             ══════════════════════════════════════════════════ -->

		<!-- REST API — @RestController, @GetMapping, @PostMapping... -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Validation — @Valid, @NotNull, @Email, @Size... -->
		<!-- Dùng trong request DTO: LoginRequest, RegisterRequest -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>


		<!-- ══════════════════════════════════════════════════
             NHÓM 2: DATABASE
             Cần cho: kết nối SQL Server, ORM, query
             ══════════════════════════════════════════════════ -->

		<!-- JPA + Hibernate — @Entity, @Repository, findById()... -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- PostgreSQL JDBC driver -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Flyway — versioned, checksummed schema migrations. Replaces the
		     spring.sql.init script list, which re-ran every boot with
		     continue-on-error=true and so could silently leave the schema
		     half-migrated with no record of what had actually been applied.
		     NOTE: must be the starter, not bare flyway-core. Spring Boot 4
		     moved Flyway auto-configuration into its own module, so with only
		     flyway-core on the classpath every spring.flyway.* property is
		     silently ignored and no migration ever runs. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>



		<!-- ══════════════════════════════════════════════════
             NHÓM 3: SECURITY & AUTH
             Cần cho: login, logout, bảo vệ endpoint, JWT

             LƯU Ý Spring Boot 4.0:
             jjwt-jackson KHÔNG tương thích với Jackson 3.0
             → Phải dùng jjwt-gson thay thế
             ══════════════════════════════════════════════════ -->

		<!-- Spring Security — filter chain, authentication, authorization -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- JWT API — interface để tạo và parse JWT token -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>

		<!-- JWT implementation — logic thực thi (runtime only) -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- JWT serialization với GSON thay vì Jackson
             QUAN TRỌNG: Spring Boot 4.0 dùng Jackson 3, jjwt-jackson
             không tương thích → dùng jjwt-gson -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-gson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Google Sign-In — verify the Google ID token (JWT) offline via
             GoogleIdTokenVerifier for the "Login with Google" flow. Uses its own
             Gson-based JSON (GsonFactory), independent of Spring's Jackson. -->
		<dependency>
			<groupId>com.google.api-client</groupId>
			<artifactId>google-api-client</artifactId>
			<version>${google-api-client.version}</version>
		</dependency>




		<!-- ══════════════════════════════════════════════════
             NHÓM 4: DOCUMENTATION
             Cần cho: Swagger UI, test API không cần Postman
             Spring Boot 4.0 → SpringDoc 3.x
             ══════════════════════════════════════════════════ -->

		<!-- Swagger UI — truy cập tại http://localhost:8080/swagger-ui.html -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>


		<!-- ══════════════════════════════════════════════════
             NHÓM 5: MONITORING & OPS
             Cần cho: health check, metrics, admin dashboard
             ══════════════════════════════════════════════════ -->

		<!-- Actuator — /actuator/health, /actuator/info -->
		<!-- DevOps dùng để monitor service có đang sống không -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>


		<!-- ══════════════════════════════════════════════════
             NHÓM 6: DEV UTILITIES
             Giảm boilerplate, tăng tốc độ code
             ══════════════════════════════════════════════════ -->

		<!-- Lombok — @Data, @Builder, @Slf4j, @RequiredArgsConstructor
             Không cần viết getter/setter/constructor thủ công -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- ModelMapper — convert Entity ↔ DTO tự động
             Ví dụ: userEntity → UserResponse DTO -->
		<dependency>
			<groupId>org.modelmapper</groupId>
			<artifactId>modelmapper</artifactId>
			<version>${modelmapper.version}</version>
		</dependency>

		<!-- DevTools — auto restart khi thay đổi code
             optional: không được đưa vào production build -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>


		<!-- ══════════════════════════════════════════════════
             NHÓM 7: TESTING
             ══════════════════════════════════════════════════ -->

		<!-- Spring Boot Test — @SpringBootTest, MockMvc, @WebMvcTest -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- No Testcontainers on purpose: its bundled docker-java cannot talk
		     to Docker Engine 29 (negotiates API 1.32, minimum accepted is
		     1.40), so the container never starts. SchemaMigrationPostgresTest
		     instead points at a Postgres supplied by the environment —
		     `services: postgres` in CI, a plain `docker run` locally — which
		     keeps the migration check deterministic and dependency-free. -->
		<!-- (postgresql JDBC driver above is promoted to test scope by the
		     runtime scope already on the classpath.) -->

		<!-- ══════════════════════════════════════════════════
             NHÓM 8: PHASE 2 — BỎ COMMENT KHI CẦN
             Chưa cần ngay, thêm khi implement feature tương ứng
             ══════════════════════════════════════════════════ -->

		<!-- dotenv handled natively via spring.config.import -->

		<!-- Redis — refresh token, blacklist token, crawler cache -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!-- Jsoup — HTML scraping for P1 masothue.vn, P3 VCCI, P5 dangkykinhdoanh -->
		<dependency>
			<groupId>org.jsoup</groupId>
			<artifactId>jsoup</artifactId>
			<version>1.18.3</version>
		</dependency>

		<!-- OpenPDF — generates the report PDF export (free iText 4 fork, LGPL/MPL) -->
		<dependency>
			<groupId>com.github.librepdf</groupId>
			<artifactId>openpdf</artifactId>
			<version>1.3.42</version>
		</dependency>

		<!-- Structured JSON logging (see logback-spring.xml) — set LOG_FORMAT=JSON
		     in production so logs are machine-parseable; defaults to a
		     human-readable console pattern for local dev. -->
		<dependency>
			<groupId>net.logstash.logback</groupId>
			<artifactId>logstash-logback-encoder</artifactId>
			<version>9.0</version>
		</dependency>

		<!-- Sentry error tracking — wired as a logback appender (see
		     logback-spring.xml) so every log.error(...) becomes a Sentry event
		     for free. No-ops with no SENTRY_DSN set. Free tier is enough at this
		     scale. -->
		<dependency>
			<groupId>io.sentry</groupId>
			<artifactId>sentry-logback</artifactId>
			<version>8.49.0</version>
		</dependency>

		<!-- Jackson for ObjectMapper (used by CacheService, FactExtractor) -->
		<dependency>
			<groupId>com.fasterxml.jackson.datatype</groupId>
			<artifactId>jackson-datatype-jsr310</artifactId>
		</dependency>


		<!-- MinIO — lưu ảnh nhà máy (Pillar 8)
             Thêm khi implement image upload
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.5.17</version>
        </dependency>
        -->

		<!-- Async / WebSocket — notification real-time khi report xong
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        -->

	</dependencies>

	<build>
		<plugins>

			<!-- Spring Boot Maven Plugin — build jar, run app -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<!-- Exclude Lombok khỏi final jar -->
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>

		</plugins>
	</build>

</project>