# ─────────────────────────────────────────────────────────────────────
# MarketScout — backend environment template
#
# 1. Copy:  cp .env.example .env
# 2. Fill in every <...> placeholder
# 3. Run database_production_v4.sql on your PostgreSQL first,
#    then start the Spring Boot app
#
# Never commit .env — only .env.example is tracked by git
# ─────────────────────────────────────────────────────────────────────

# ── JWT ───────────────────────────────────────────────────────────────
# Must be identical on every machine — tokens are validated server-side
JWT_SECRET=<at-least-256-bit-random-string>
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ── Database (PostgreSQL) ─────────────────────────────────────────────
# Requires: PostgreSQL running, database "marketscout" created
# Script  : database_production_v4.sql (full schema + seed + 5 admin accounts)
DB_URL=jdbc:postgresql://localhost:5432/marketscout
DB_USERNAME=postgres
DB_PASSWORD=<your_postgres_password>

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Mailtrap ──────────────────────────────────────────────────────────
MAILTRAP_API_TOKEN=<your_mailtrap_api_token>
MAILTRAP_API_URL=https://send.api.mailtrap.io/api/send
MAILTRAP_FROM_EMAIL=hello@demomailtrap.co
MAILTRAP_FROM_NAME=MarketScout

# ── App URLs ──────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:3000

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call /api/** from the browser.
# Local Next.js dev server default: http://localhost:3000
# Production: set to your deployed frontend URL(s), e.g.
#   CORS_ALLOWED_ORIGINS=https://marketscout.io.vn
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Gemini AI (Google AI Studio) ──────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<your_gemini_api_key>
# Optional: override the model id if Google retires the default (gemini-2.5-flash).
# See https://ai.google.dev/gemini-api/docs/models for currently supported models.
# GEMINI_MODEL=gemini-2.5-flash

# ── Tavily (Web Search / Crawler) ─────────────────────────────────────
# Get your key at: https://app.tavily.com
TAVILY_API_KEY=<your_tavily_api_key>

# ── OpenStreetMap Nominatim (address geocoding, P4) ───────────────────
# Free, no API key. Their usage policy caps the public instance at 1 req/sec
# and requires identifying the caller — set a real inbox here before going
# live. Self-host your own Nominatim instance if traffic ever needs more
# than the shared public instance's limit.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_CONTACT_EMAIL=contact@marketscout.io.vn

# ── TinEye (Reverse Image Search) ─────────────────────────────────────
TINEYE_API_KEY=<your_tineye_api_key>

# ── OpenSanctions ──────────────────────────────────────────────────────
# Self-hosted OpenSanctions API (yente). Leave blank to disable sanctions check.
OPENSANCTIONS_URL=http://localhost:8080
OPENSANCTIONS_API_KEY=<your_opensanctions_api_key>

# ── Scoring ────────────────────────────────────────────────────────────
# Optional: path or JSON string for custom scoring rubric config.
# Leave blank to use the built-in default rubric.
SCORING_RUBRIC_CONFIG=

# ── Server ─────────────────────────────────────────────────────────────
# PORT is read by Railway automatically. For local dev, 8080 is the default.
PORT=8080
