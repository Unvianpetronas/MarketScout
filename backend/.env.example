# ─────────────────────────────────────────────────────────────────────
# MarketScout — backend environment template
#
# 1. Copy:  cp .env.example .env
# 2. Fill in every <...> placeholder
# 3. Run the matching SQL script FIRST, then start Spring Boot
#
# dev  profile → SQL Server → run create_database.sql
# prod profile → PostgreSQL → run create_database_postgres.sql
#
# Never commit .env — only .env.example is tracked by git
# ─────────────────────────────────────────────────────────────────────

# ── Profile ───────────────────────────────────────────────────────────
# dev  = SQL Server (local)
# prod = PostgreSQL (production)
SPRING_PROFILES_ACTIVE=dev

# ── JWT ───────────────────────────────────────────────────────────────
# MUST be identical on every machine — tokens are validated server-side
JWT_SECRET=<at-least-256-bit-random-string>
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ── Database ──────────────────────────────────────────────────────────
# --- dev (SQL Server) ---
# Requires: SQL Server on localhost:1433, SQL Auth enabled
# Script  : create_database.sql
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=MarketScout;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=<your_sa_password>

# --- prod (PostgreSQL) — swap these three lines on the server ---
# Requires: PostgreSQL on host:5432
# Script  : create_database_postgres.sql
# DB_URL=jdbc:postgresql://<host>:5432/marketscout
# DB_USERNAME=<pg_user>
# DB_PASSWORD=<pg_password>

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Mailtrap ──────────────────────────────────────────────────────────
MAILTRAP_API_TOKEN=<your_mailtrap_api_token>
MAILTRAP_API_URL=https://send.api.mailtrap.io/api/send
MAILTRAP_FROM_EMAIL=hello@demomailtrap.co
MAILTRAP_FROM_NAME=MarketScout

# ── App URLs ──────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:5173
