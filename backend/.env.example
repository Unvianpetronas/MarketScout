# Copy this file to .env and fill in your values
# Never commit .env — only .env.example is committed

# ── JWT ──────────────────────────────────────────────────────────────
JWT_SECRET=your-secret-key-at-least-256-bits-long-for-hs256
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ── Database (SQL Server) ─────────────────────────────────────────────
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=MarketScout;encrypt=true;trustServerCertificate=true
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Mailtrap ──────────────────────────────────────────────────────────
MAILTRAP_API_TOKEN=your_mailtrap_api_token
MAILTRAP_API_URL=https://send.api.mailtrap.io/api/send
MAILTRAP_FROM_EMAIL=hello@yourdomain.com
MAILTRAP_FROM_NAME=MarketScout

# ── App URLs ──────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:5173
